# =============================================================================
# NIDS Environment Variables
# Copy this file to .env and fill in the values
# =============================================================================

# --- Database ---
# SQLite (default):
NIDS_DB__URL=sqlite:///logs/nids.db
# PostgreSQL (production):
# NIDS_DB__URL=postgresql://nids:changeme@postgres:5432/nids
# NIDS_DB__POOL_SIZE=5
# NIDS_DB__MAX_OVERFLOW=10
# NIDS_DB__ECHO=false

# --- Capture ---
# NIDS_CAPTURE__INTERFACE=eth0
# NIDS_CAPTURE__PACKET_FILTER=tcp
# NIDS_CAPTURE__BATCH_TIMEOUT=10
# NIDS_CAPTURE__MAX_QUEUE_DEPTH=10000

# --- ML Model ---
# NIDS_ML__MODEL_DIR=models/versions
# NIDS_ML__RETRAIN_INTERVAL_HOURS=24
# NIDS_ML__RETRAIN_WINDOW_HOURS=168
# NIDS_ML__CONTAMINATION=0.05
# NIDS_ML__ENSEMBLE_THRESHOLD=2

# --- Email Notifications ---
NIDS_EMAIL__ENABLED=false
NIDS_EMAIL__HOST=smtp.gmail.com
NIDS_EMAIL__PORT=587
NIDS_EMAIL__USER=
NIDS_EMAIL__PASSWORD=
NIDS_EMAIL__FROM=
NIDS_EMAIL__TO=

# --- Slack Notifications ---
NIDS_SLACK__ENABLED=false
NIDS_SLACK__WEBHOOK=

# --- PagerDuty ---
NIDS_PAGERDUTY__ENABLED=false
NIDS_PAGERDUTY__ROUTING_KEY=

# --- Microsoft Teams ---
NIDS_TEAMS__ENABLED=false
NIDS_TEAMS__WEBHOOK=

# --- Syslog ---
NIDS_SYSLOG__ENABLED=false
NIDS_SYSLOG__HOST=localhost
NIDS_SYSLOG__PORT=514
NIDS_SYSLOG__PROTOCOL=udp

# --- API / JWT ---
NIDS_JWT__SECRET=changeme_super_secret_jwt_key_here
NIDS_JWT__ALGORITHM=HS256
NIDS_JWT__EXPIRY_HOURS=24
NIDS_JWT__RATE_LIMIT_PER_MINUTE=100

# --- Dashboard ---
# NIDS_API__DASHBOARD__HOST=0.0.0.0
# NIDS_API__DASHBOARD__PORT=5000
# NIDS_API__DASHBOARD__DEBUG=false

# --- API Authentication (for /auth/login endpoint) ---
NIDS_API__USER=admin
NIDS_API__PASSWORD=admin

# --- Threat Intelligence ---
# NIDS_THREATINTEL__ABUSEIPDB_API_KEY=
# NIDS_THREATINTEL__ABUSEIPDB_CHECK_SEVERITY=50
# NIDS_THREATINTEL__CACHE_TTL_SECONDS=3600
# NIDS_THREATINTEL__ENABLED=true

# --- Rate Limits ---
# NIDS_RATELIMIT__PACKETS_PER_SECOND_PER_IP=1000
# NIDS_RATELIMIT__EVENTS_PER_SECOND=100

# --- Notification Settings ---
# NIDS_NOTIFICATIONS__DEDUP_WINDOW_SECONDS=300
# NIDS_NOTIFICATIONS__MAX_RETRIES=3
# NIDS_NOTIFICATIONS__RETRY_BACKOFF_BASE=2.0

# --- Redis (for threat intel caching) ---
REDIS_HOST=localhost
REDIS_PORT=6379
